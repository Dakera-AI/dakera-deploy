# cloudflared ingress for Dakera Cloud. Copy to config.yml and fill in the
# tunnel id; the credentials file comes from `cloudflared tunnel create`.
# Rules match top to bottom; the first match wins.
tunnel: <tunnel-id>
credentials-file: /etc/cloudflared/<tunnel-id>.json

ingress:
  # Never from the internet: Prometheus scrapes /metrics on dakera-net, the
  # operator reaches /admin on 127.0.0.1:3000, peers /internal directly.
  - hostname: api.dakera.ai
    path: ^/(metrics|admin|internal)(/|$)
    service: http_status:404
  - hostname: engine-origin.dakera.ai
    path: ^/(metrics|admin|internal)(/|$)
    service: http_status:404
  # Public data plane: SDKs, CLI, MCP. Straight to the engine.
  - hostname: api.dakera.ai
    service: http://dakera:3000
    originRequest:
      connectTimeout: 10s
      keepAliveTimeout: 25s
  # The console's Pages Functions only: Cloudflare Access requires their
  # service token on this hostname.
  - hostname: engine-origin.dakera.ai
    service: http://dakera:3000
    originRequest:
      connectTimeout: 10s
      keepAliveTimeout: 25s
  # Staff only (Access SSO): Grafana.
  - hostname: ops.dakera.ai
    service: http://grafana:3000
  - service: http_status:404
