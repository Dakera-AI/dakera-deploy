# =============================================================================
# Dakera HA Stack — Port Override Example
# =============================================================================
# Copy to .env.ha and customize for your deployment.
#
# The HA stack is designed for dedicated production hardware. When running
# both the single-node stack (docker-compose.yml) and the HA stack on the
# same server, use the HA_* variables below to avoid port conflicts.
#
# All HA_* vars have safe defaults that don't conflict with the single-node
# stack defaults. You only need this file if you're co-deploying both stacks
# on one machine.
#
# Usage:
#   docker compose -f docker-compose.ha.yml --env-file .env.ha up -d
# =============================================================================

# --- Load Balancer (Traefik) ---
HA_LB_HTTP_PORT=3100        # single-node uses 3000
HA_LB_GRPC_PORT=50151       # single-node uses 50051
HA_TRAEFIK_PORT=8080        # no conflict (single-node doesn't expose this)
# Only HA_LB_* are published on every interface; MinIO, the dashboard, the Traefik
# dashboard, Prometheus, Grafana and Jaeger are bound to 127.0.0.1.

# --- Storage (MinIO) ---
HA_MINIO_API_PORT=9100      # single-node uses 9000
HA_MINIO_CONSOLE_PORT=9101  # single-node uses 9001

# --- Dashboard ---
HA_DASHBOARD_PORT=3202      # single-node uses 3002
# Dashboard 0.5.2 (as 0.4.0 / 0.5.x) has no API key: operators sign in with their own key (DAKERA_API_KEY and
# DAKERA_CLIENT_URL are no longer used; rotate any key the old dashboard carried).
# DAKERA_SESSION_TTL_HOURS=12   # longest a sign-in lasts, hours (idle ends after 2 h)
# DAKERA_TRUSTED_PROXIES=       # dashboard 0.5.2: proxies (IPs / CIDRs) whose X-Forwarded-For names the client

# --- Monitoring (--profile monitoring) ---
HA_PROMETHEUS_PORT=9190     # single-node uses 9090
HA_GRAFANA_PORT=3203        # single-node uses 3003
HA_JAEGER_UI_PORT=16787     # single-node uses 16686
GRAFANA_PASSWORD=             # REQUIRED: docker-compose.ha.yml does not start without it (any profile)

# --- Dakera image ---
# DAKERA_IMAGE=ghcr.io/dakera-ai/dakera:0.12.3

# --- Cluster secret (REQUIRED; no default) ---
# Authenticates node-to-node routes and gossip: at least 16 characters, the same
# on every node. Generate with: openssl rand -hex 32
# From 0.12.1 a cluster node without it exits with code 78 (fresh or upgraded), and
# docker-compose.ha.yml refuses to start while it is empty. A cluster upgraded from
# one that ran without it: set it and restart ALL nodes in one window (README,
# "Upgrading from v0.12.0 to v0.12.1").
DAKERA_CLUSTER_SECRET=

# --- Auth (production: set a strong key) ---
# DAKERA_AUTH_ENABLED=true
# DAKERA_ROOT_API_KEY=dk_prod_your_key_here

# --- MinIO credentials (production: change these) ---
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# --- Encryption at rest (optional) ---
# 64 hex characters or a passphrase of at least 8 characters; the SAME value on every
# node. Keys rotate through a keyring (docs/features-v0.12.md, "Security").
# DAKERA_ENCRYPTION_KEY=

# --- Model downloads (optional; empty = the Hugging Face Hub, directly) ---
# The three nodes share one dakera-models volume: a model downloads once.
# HF_ENDPOINT=https://hf-mirror.example.internal
# HF_HUB_OFFLINE=1
# HTTPS_PROXY=http://proxy.example.internal:3128
# NO_PROXY=127.0.0.1,localhost,minio,dakera-1,dakera-2,dakera-3
# HF_TOKEN=

# --- v0.12 features (ALL OFF BY DEFAULT; docs/features-v0.12.md) ---
# Switched on by the HA overlays, which set the same variables on all three nodes:
#   docker compose -f docker-compose.ha.yml -f docker-compose.ha.multilingual.yml up -d
# Overlays: ha.multilingual, ha.multimodal, ha.late-interaction, ha.records, ha.rabitq.
# multilingual and late-interaction change the embedding model, and they are exclusive.
# multilingual on an existing store: from 0.12.1 the store is re-embedded in the
# background (the leader does it). late-interaction: FRESH STORE only (or
# DAKERA_ALLOW_MODEL_CHANGE=1 for one start plus a re-embed).
# Tuning variables (all optional; see .env.example, "v0.12 features"):
# DAKERA_FULLTEXT_LANGUAGE=multilingual
# DAKERA_QUERY_LANG=auto
# DAKERA_ATTACHMENT_MAX_BYTES=26214400
# DAKERA_RECORD_MAX_VECTORS=4096
# DAKERA_RABITQ_BITS=1

# --- Server v0.12.3 (optional; .env.example, "Recall and connections") ---
# Passed only when set. Traefik closes idle connections to the nodes after 25 s
# (traefik-dynamic.yml): keep DAKERA_HTTP_HEADER_READ_TIMEOUT_SECS above that.
# DAKERA_HTTP_HEADER_READ_TIMEOUT_SECS=30
# DAKERA_NEIGHBORHOOD_MODE=inline
# DAKERA_RECALL_RANK_DEPTH=10
# DAKERA_MAX_CONNECTIONS=10000
# DAKERA_SHUTDOWN_DRAIN_SECS=8      # + 15 s of media jobs must stay below stop_grace_period (30 s)
# DAKERA_ALLOWED_HOSTS=             # only with DAKERA_AUTH_ENABLED=false: dotted Host names to accept
# Document import (on by default; .env.example "Document import"), same on every node:
# DAKERA_DOCUMENTS=true
# DAKERA_DOCUMENT_MAX_BYTES=26214400
# DAKERA_DOCUMENT_EXTRACT_CONCURRENCY=2   # x DAKERA_DOCUMENT_EXTRACT_MEMORY_MB (1024) on top of each node
