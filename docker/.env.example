# =============================================================================
# Dakera Deploy — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in REQUIRED values before starting:
#   cp .env.example .env
#   # Edit .env, then:
#   docker compose up -d
#
# IMPORTANT: Never commit .env to version control.
# =============================================================================

# =============================================================================
# Authentication (REQUIRED for production)
# =============================================================================

# Enable API key authentication — required for any internet-facing deployment
DAKERA_AUTH_ENABLED=true

# Root API key — generate a strong random key before deploying:
#   openssl rand -hex 32
DAKERA_ROOT_API_KEY=

# =============================================================================
# Encryption (optional — enables AES-256-GCM at-rest memory encryption)
# =============================================================================

# AES-256-GCM at rest: memory content, text and the full-text indexes are sealed
# before they reach the WAL, RocksDB, S3, backups and cluster replication.
# 64 hex characters (a raw 256-bit key) or a passphrase of at least 8 characters.
# Leave blank to disable. Generate with: openssl rand -hex 32
# The SAME value on every node. Rotating keys needs no change here: v0.12 keeps a
# keyring and POST /admin/encryption/rotate-key adds a key (see
# docs/features-v0.12.md, "Security").
# DAKERA_ENCRYPTION_KEY=

# =============================================================================
# MinIO Credentials (REQUIRED — change from defaults)
# =============================================================================

# Change these from the defaults before deploying:
#   openssl rand -hex 16
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# =============================================================================
# Port Mapping (optional — uncomment to override defaults)
# =============================================================================

# DAKERA_PORT=3000
# DAKERA_GRPC_PORT=50051
# LB_HTTP_PORT=3000
# LB_GRPC_PORT=50051
# TRAEFIK_DASHBOARD_PORT=8080
# DASHBOARD_PORT=3002
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3003
# JAEGER_UI_PORT=16686

# =============================================================================
# Search & Ranking (optional — defaults are production-tuned)
# =============================================================================
# Defaults below are the server's own (the server's .engine-feature-flags.json);
# the recall levers were tuned on LoCoMo: change one only after measuring.

# How the HNSW index searches: hybrid (default), binary, float, scalar (alias sq)
# or rabitq. An unknown value runs `hybrid` (a fresh install refuses it).
# RaBitQ is a LATENCY option and saves no memory: see "RaBitQ" below.
# DAKERA_SEARCH_MODE=hybrid

# Hybrid+rerank coarse fetch multiplier: a positive INTEGER (unset = 5x).
# Higher = better recall, slower.
# DAKERA_HYBRID_FETCH_MULT=5

# BM25 tuning (hybrid / full-text search)
# DAKERA_BM25_K1=1.2
# DAKERA_BM25_B=0.75
# DAKERA_BM25_DELTA=1.0

# RRF fusion constant, 1-1000 (used when DAKERA_FUSION_STRATEGY=rrf)
# DAKERA_RRF_K=60

# Weight of temporal proximity in the precision rerank of temporal queries
# DAKERA_TEMPORAL_RERANK_GAMMA=0.30

# Adaptive vector weight when the cross-encoder is confident
# DAKERA_ADAPTIVE_WVEC_BOOST=0.65
# DAKERA_ADAPTIVE_WVEC_THRESHOLD=0.15

# PPR (Personalized PageRank) graph proximity fusion (on by default)
# DAKERA_PPR_FUSION=1

# Bitemporal validity weight in post-ranking
# DAKERA_BITEMPORAL_WEIGHT=0.1

# Person-name score boost, 0.0-1.0 (0 = off)
# DAKERA_NAME_BOOST=0.3

# Supersession demotion (ON by default — opt-OUT with 0/false)
# DAKERA_SUPERSEDE_DEMOTE=1

# Cap how many candidates the cross-encoder scores in ONE recall (its cost is
# per candidate; the rest keep their retrieval order). Unset = from v0.12.3 the
# largest pool a top_k <= 10 recall builds (195 with the default settings); 0 = no
# cap. A request's `rerank_candidates` is capped by this. See "Rerank" below.
# DAKERA_RERANK_MAX_CANDIDATES=

# =============================================================================
# Storage & Tiering (optional — defaults to S3 with tiered storage)
# =============================================================================

# Storage backend: "s3", "filesystem" or "memory" (tiered storage needs "s3")
# DAKERA_STORAGE=s3

# Data root (default /data in the image and the compose files): WAL, knowledge
# graph, hot and warm tiers derive from it. Replaces v0.11's DAKERA_L2_CACHE_PATH.
# DAKERA_STORAGE_PATH=/data

# S3 / MinIO connection (auto-configured when using the bundled MinIO)
# DAKERA_S3_ENDPOINT=http://minio:9000
# DAKERA_S3_BUCKET=dakera
# DAKERA_S3_REGION=us-east-1

# Tiered STORAGE (hot → warm → cold; needs DAKERA_STORAGE=s3). The hot tier is
# RocksDB (durable, fsynced) by default in v0.12: DAKERA_HOT_TIER=memory keeps
# the v0.11 in-memory tier, DAKERA_ROCKSDB_SYNC=false skips the fsync.
# DAKERA_TIERED_STORAGE=true
# DAKERA_AUTO_TIER=true
# DAKERA_HOT_TO_WARM_SECS=3600
# DAKERA_WARM_TO_COLD_SECS=86400
# DAKERA_TIER_CHECK_INTERVAL_SECS=300

# Hot-tier budget of tiered storage (no effect without DAKERA_TIERED_STORAGE).
# With a unit suffix (512MB, 1g) it is bytes; a bare number below 10 million is a
# vector COUNT (the default is 100000 vectors). Bare numbers of 10 million or
# more are bytes, with a warning: write the suffix.
# DAKERA_L1_CACHE_SIZE=512MB
# Not to be confused with the in-process L1 VECTOR cache (point reads of recent
# records), sized by DAKERA_VECTOR_CACHE_BYTES (default 128MB; bare number = bytes).
# DAKERA_VECTOR_CACHE_BYTES=256MB

# On-disk encoding of RocksDB hot-tier records (v0.12.2): binary (default; raw
# float embeddings, smaller and faster) or json. Both are always read. Before
# starting v0.11.108 on this data, run `dakera downgrade` (rewrites binary as JSON).
# DAKERA_ROCKSDB_RECORD_FORMAT=binary

# Tiered EMBEDDING engine (static fast write, background re-embed). NOT the same as
# tiered storage. It always embeds with bge-large and ignores DAKERA_MODEL, and it
# cannot be combined with late interaction, so the multilingual / late-interaction /
# vision overlays set it to 0. The compose default is 1 (this variable overrides it
# for a stack without an overlay). Must be the same on every node that shares a store.
# DAKERA_TIERED=1

# =============================================================================
# Memory and sessions (v0.12.2)
# =============================================================================

# Longest memory content in BYTES (UTF-8) accepted by store, batch, update and
# import. An update of a memory already above it may not grow it further.
# DAKERA_MAX_MEMORY_CONTENT_BYTES=100000

# Sessions with no activity for this many seconds are ended by the server (same
# summary and consolidation as a client end). 0 = the server ends no session that
# did not set its own idle_timeout_secs. Clients keep an idle session open with
# POST /v1/sessions/{id}/touch, or start it with idle_timeout_secs: 0.
# DAKERA_SESSION_IDLE_TIMEOUT_SECS=14400

# =============================================================================
# Recall and connections (server v0.12.3; optional)
# =============================================================================
# Passed to the server only when set here (an image up to v0.12.2, e.g. an older
# DAKERA_IMAGE, does not know them and would list them as unknown variables).
# Same value on every node.

# Seconds a client has to send a complete HTTP/1 request head on the REST port,
# counted from when the server waits for one: a new connection or an IDLE
# KEEP-ALIVE one, which is closed after this long. Integer, [1, 86400]. A proxy or
# load balancer that keeps idle connections to the server longer than this would
# reuse closed ones (502s): keep its upstream idle timeout below this value
# (docker-compose.ha.yml's Traefik: 25 s), or raise this above it.
# DAKERA_HTTP_HEADER_READ_TIMEOUT_SECS=30
# (From 0.12.3 the same deadline also closes an HTTP/2 connection that sends no request.)

# Most REST connections open at once; one over the cap is closed at once.
# [1, 1000000], default 10000. Keep it below the container's file-descriptor limit
# (ulimits nofile: 65536 here).
# DAKERA_MAX_CONNECTIONS=10000

# Longest the REST drain at shutdown, in seconds [0, 3600], default 8 (streams (SSE)
# end at the shutdown signal). The server first waits up to 15 s for running media
# jobs: keep the sum below the compose stop_grace_period (30 s), or raise that too.
# DAKERA_SHUTDOWN_DRAIN_SECS=8

# Only with DAKERA_AUTH_ENABLED=false: the Host names accepted besides localhost,
# *.localhost, IP addresses, single-label names (e.g. `dakera`) and private-use names
# (*.internal, *.local, *.home.arpa: host.docker.internal, a Kubernetes service FQDN); comma separated,
# `*` = any. Any other Host gets 421 HOST_NOT_ALLOWED (a DNS-rebinding guard;
# /health* and /internal/* are exempt). A stack without auth reached by a dotted name
# (a DNS name, a proxy's public host) MUST list it.
# DAKERA_ALLOWED_HOSTS=dakera.internal.example

# =============================================================================
# Document import (server v0.12.3; optional) — server docs/documents.md
# =============================================================================
# POST /v1/memory/documents (text, Markdown, HTML) and
# POST /v1/namespaces/{ns}/attachments/{ref}/document (PDF, DOCX, ...; the attachment
# lane, DAKERA_ATTACHMENTS, must be on). Passed only when set.
# The routes; false / 0 = 501 FEATURE_DISABLED. Default on.
# DAKERA_DOCUMENTS=true
# Largest source document, bytes (default 26214400 = 25 MiB). A proxy in front must
# accept bodies this large (the compose files set no proxy limit; DAKERA_MAX_BODY_SIZE
# is 500 MB here).
# DAKERA_DOCUMENT_MAX_BYTES=26214400
# Most extracted text, bytes (default 20971520 = 20 MiB).
# DAKERA_DOCUMENT_MAX_TEXT_BYTES=20971520
# Most chunks per document (default 5000).
# DAKERA_DOCUMENT_MAX_CHUNKS=5000
# Default chunk budget in tokens [32, 8192] (default 400; clamped to the model's cap)
# and overlap [0, 1024] (default 50).
# DAKERA_DOCUMENT_CHUNK_TOKENS=400
# DAKERA_DOCUMENT_CHUNK_OVERLAP_TOKENS=50
# PDF / DOCX are parsed by `dakera extract-text` child processes: wall clock per
# extraction (default 60 s), address-space limit per child (default 1024 MB) and how
# many at once (default 2). Memory: the server's own use plus up to
# CONCURRENCY x MEMORY_MB must fit in the container limit (12G in docker-compose.yml).
# DAKERA_DOCUMENT_EXTRACT_TIMEOUT_SECS=60
# DAKERA_DOCUMENT_EXTRACT_MEMORY_MB=1024
# DAKERA_DOCUMENT_EXTRACT_CONCURRENCY=2

# =============================================================================
# Throughput and safety (server v0.12.3; optional) — server README env tables
# =============================================================================
# Unset, each is sized by the server from the host (cores, memory limit). Set one only
# to override it. Passed only when set.
# Inference permits for writes (default max(4, cores/2)) and how long a write waits for
# one before 429 + Retry-After (default 20 s). Bulk loaders (many parallel writers)
# can raise the wait, with DAKERA_REQUEST_TIMEOUT above it.
# DAKERA_MAX_CONCURRENT_INFERENCES=
# DAKERA_ADMISSION_WAIT_SECS=20
# Cores ingest leaves to searches while a search waits (default max(1, cores/2)).
# DAKERA_INTERACTIVE_MIN_CORES=
# ONNX weight prepacking for the embedder / reranker: bit-identical results, faster
# (2-2.5x short embeds, 27-50% less CPU per rerank pair), ~0.3 GB RAM per core each.
# Default auto: on only under a container memory limit the copies fit 20% of.
# docker-compose.yml gives the server a 12G / 4 CPU limit, so both are ON there
# (about +2.8 GB resident from startup): set both to 0 to keep the shared weight
# mapping. docker-compose.ha.yml sets no limit on its nodes, so they are off there.
# DAKERA_EMBED_PREPACK=
# DAKERA_RERANK_PREPACK=
# Cross-encoder: model (default bge-reranker-v2-m3, multilingual; `base` =
# bge-reranker-base, English/Chinese, ~3.4x cheaper per pair), exact score cache
# entries (default 65536, 0 = off), and most passage tokens per pair (default 0 = as
# many as fit; a long passage is scored on its best window).
# DAKERA_RERANKER_MODEL=
# DAKERA_RERANK_CACHE_ENTRIES=65536
# DAKERA_RERANK_PASSAGE_TOKENS=0
# ANN index cache budget in bytes (default 40% of the memory limit).
# DAKERA_HNSW_CACHE_BYTES=
# Periodic allocator trim after growth, seconds (default 60, 0 = off).
# DAKERA_MEM_TRIM_INTERVAL_SECS=60
# Overlapping token windows for text longer than the embedder reads (default off).
# DAKERA_LONG_CONTENT_WINDOWS=0
# Audit-log sampling of writes / reads (default 1.0 each; deletions, admin, key and
# security events are always logged).
# DAKERA_AUDIT_SAMPLE_RATE=1.0
# DAKERA_AUDIT_READ_SAMPLE_RATE=1.0
# Autopilot dedup: off (default) / report / merge. Removed duplicates and consolidated
# sources go to a restorable trash for TRASH_RETENTION_HOURS (default 168).
# DAKERA_AUTOPILOT_DEDUP_MODE=off
# DAKERA_AUTOPILOT_DEDUP_CROSS_SESSION=false
# DAKERA_AUTOPILOT_CONSOLIDATE_CROSS_SESSION=false
# DAKERA_AUTOPILOT_TRASH_RETENTION_HOURS=168
# Tiered re-embed (DAKERA_TIERED=1): memories per cycle (default 50) and the idle poll
# in seconds (default 300). A backlog drains back to back; the interval is not a rate.
# REEMBED_BATCH_SIZE=50
# REEMBED_INTERVAL_SECS=300

# Neighbourhood context of POST /v1/memory/recall when a request names none:
# inline (default: appended after the top_k ranked results, each marked
# retrieval: "neighborhood"), separate (returned in context_memories, so memories
# holds at most top_k) or off.
# DAKERA_NEIGHBORHOOD_MODE=inline
# Neighbourhood window on event time instead of ingest time (default off).
# DAKERA_NEIGHBORHOOD_EVENT_TIME=0
# Ranking depth floor [1, 1000]: the first k results of a top_k=k recall are the
# first k of a top_k=10 recall for k <= this (default 10).
# DAKERA_RECALL_RANK_DEPTH=10
# One result per source memory: derived sentence sub-memories are collapsed into
# their source (matched_text / matched_ids). Default off.
# DAKERA_RECALL_COLLAPSE_DERIVED=0
# Keep session summaries out of recall unless a request asks include_summaries=true
# (default off).
# DAKERA_RECALL_EXCLUDE_SUMMARIES=0
# At most N results of one session in the head of list / aggregation recalls
# (default 0 = no cap).
# DAKERA_RECALL_SESSION_CAP=0
# Write-time sentence decomposition on every path; 0 derives none (default on).
# DAKERA_SENTENCE_DECOMP=1
# Supersedes edges ordered by event date when both memories carry one (default on).
# DAKERA_SUPERSEDES_EVENT_TIME=1

# =============================================================================
# Performance (optional)
# =============================================================================

# Request timeout in seconds. The server default is 300; docker-compose.yml sets 600
# and docker-compose.ha.yml 120 (it is the outer ceiling: a write or recall that waits
# DAKERA_ADMISSION_WAIT_SECS, 20 s, for a slot answers 429 + Retry-After).
# DAKERA_REQUEST_TIMEOUT=600

# Max request body size in bytes. The server default is 10 MiB; this compose file
# sets 500 MB (backups, imports and attachment uploads). An attachment upload is
# also capped by DAKERA_ATTACHMENT_MAX_BYTES (25 MiB).
# DAKERA_MAX_BODY_SIZE=524288000

# gRPC endpoint toggle (default: true; the compose file passes true explicitly: an
# EMPTY value would read as OFF on an upgraded deployment). v0.12 gRPC needs an API key in the call
# metadata (x-api-key / authorization: Bearer) whenever authentication is on.
# DAKERA_GRPC_ENABLED=true

# Server-wide rate limit (requests per second / burst). v0.11's RATE_LIMIT_RPS
# still works, deprecated.
# DAKERA_RATE_LIMIT_RPS=100
# DAKERA_RATE_LIMIT_BURST=50

# =============================================================================
# Model downloads (optional) — docs/features-v0.12.md, "The model store"
# =============================================================================
# The image ships bge-large and the reranker, ready to use, no network needed.
# Every other model (bge-m3, colbert-small, whisper, the visual model, GLiNER)
# downloads from Hugging Face into the dakera-models volume (/app/models) on
# first use, is converted once, and stays there. Fetch ahead of time:
#   docker compose run --rm dakera models pull bge-m3 whisper vision
#   docker compose run --rm dakera models list        # what is on disk, how big
#   docker compose run --rm dakera models prune --dry-run
# All of the variables below are passed to the server; empty = unset.

# Hugging Face token (gated models only; sent to the Hub's own origin only).
# HF_TOKEN=

# A Hugging Face mirror / internal proxy of the Hub, instead of https://huggingface.co
# HF_ENDPOINT=https://hf-mirror.example.internal

# Never download (air-gapped): a file missing from the volume and the image fails
# at once, naming it. Seed the volume first (models pull --dir, see the guide).
# HF_HUB_OFFLINE=1

# A forward proxy for the downloads (http://, socks4://, socks4a://, socks5://,
# socks5h://; an https:// proxy URL is NOT supported). Credentials go in the URL.
# HTTPS_PROXY=http://proxy.example.internal:3128
# HTTP_PROXY=
# ALL_PROXY=
# Hosts reached directly. Keep the compose service names and loopback here so the
# proxy is never used for MinIO, Redis, the health check or the other nodes:
# NO_PROXY=127.0.0.1,localhost,minio,redis,dakera-1,dakera-2,dakera-3

# Where HF_HOME is mounted: the dakera-models volume at /app/models (compose).

# =============================================================================
# v0.12 features (ALL OFF BY DEFAULT) — docs/features-v0.12.md
# =============================================================================
# Each feature below is switched on by an overlay file next to the base file,
# which sets the variables it needs (and the ones it must change, e.g.
# DAKERA_TIERED=0). The variables listed here only TUNE what an overlay enables;
# with no overlay, setting them changes nothing the overlay does not read.
#
#   docker compose -f docker-compose.yml -f docker-compose.multilingual.yml up -d
#   docker compose -f docker-compose.ha.yml -f docker-compose.ha.multilingual.yml up -d
#
# Overlays and what they must not be combined with:
#   multilingual       bge-m3 + per-language full-text      (not with late-interaction, vision)
#   multimodal         attachments + speech to text         (any text overlay; Whisper model is a choice)
#   late-interaction   colbert-small + MaxSim rerank        (not with multilingual, vision)
#   vision             image / page indexing + visual recall (a dedicated stack; nothing else)
#   records            one vector + named extra vectors     (any)
#   rabitq             RaBitQ search mode                   (any; saves latency, not memory)
#
# The store records its embedding model. From 0.12.1 an existing store started with
# multilingual (bge-m3) is re-embedded in the background; late-interaction and vision
# still need a fresh store or a model-change migration (DAKERA_ALLOW_MODEL_CHANGE=1
# plus a re-embed): see "Switching the embedding model" in the guide.

# --- Multilingual (docker-compose.multilingual.yml) ---------------------------
# Embedding model of the overlay (1024-d, multilingual, CPU ONNX only, ~570 MB
# download). Truncation defaults to 2048 tokens (a long text needs memory:
# one 8192-token row costs about 4 GiB of attention scores per layer).
# DAKERA_MODEL=bge-m3
# DAKERA_MAX_SEQ_LENGTH=2048
# BM25 analyzer: an ISO 639-1 code or an English name (de, french, pt-BR, ...);
# zh / ja / ko / th / none / multilingual = no stemming. The overlay's default is
# "multilingual". Stored with each index; from 0.12.1 an existing index built with
# another analyzer is re-analysed in the background at the next start.
# DAKERA_FULLTEXT_LANGUAGE=multilingual
# Character-bigram indexing of unsegmented scripts (Chinese, Japanese, Korean,
# Thai...). Follows the language (off for en, on otherwise); true forces it on.
# DAKERA_FULLTEXT_CJK_BIGRAMS=
# Language of the query-routing patterns, temporal expressions and date
# extraction: en, de, fr, es, it, pt, nl or auto (detect per query). Requests may
# also send "lang" per call. The overlay's default is "auto".
# DAKERA_QUERY_LANG=auto

# --- Multimodal (docker-compose.multimodal.yml) -------------------------------
# The overlay sets DAKERA_ATTACHMENTS=1 (attachments + speech to text; whisper-
# base by default, WAV only; the model table is in docs/features-v0.12.md). Largest upload,
# bytes (default 25 MiB):
# DAKERA_ATTACHMENT_MAX_BYTES=26214400
# Speech-to-text model (default whisper-base):
#   whisper-base      multilingual (~99 languages), language auto-detected; the default, recommended
#   whisper-tiny.en   English, the lightest (~151 MB)
#   whisper-base.en   English, better
#   whisper-tiny      multilingual, the lightest
#   whisper-small     multilingual, the quality option
# Upgrading: with no DAKERA_WHISPER_MODEL set, speech now transcribes with whisper-base;
# set whisper-tiny.en to keep the lightest English model.
# Multilingual models record the detected language as the memory's lang.
# Sizes of the new models: see docs/features-v0.12.md (TODO: measured figures pending).
# DAKERA_WHISPER_MODEL=whisper-base
# A media job reserves its peak memory against the memory limit x this fraction
# (default 0.85), waits up to 10 s, then answers 503 + Retry-After.
# DAKERA_MEM_HIGH_WATER_FRACTION=0.85
# Idle whisper / visual / GLiNER models are unloaded after this many seconds (3600).
# DAKERA_HNSW_CACHE_TTI_SECS=3600

# --- Vision (docker-compose.vision.yml) ----------------------------------------
# Image / page indexing and visual recall (colmodernvbert, ~966 MB download,
# about 10.7 s per page on CPU). The overlay sets DAKERA_ATTACHMENTS=1,
# DAKERA_VISION=1 and DAKERA_SCORING_STRATEGY=late-interaction, a dedicated
# bucket and dedicated volumes: never point it at an existing text store.

# --- Late interaction (docker-compose.late-interaction.yml) -------------------
# DAKERA_MODEL=colbert-small (96-d token vectors, ~34 MB) +
# DAKERA_SCORING_STRATEGY=late-interaction. Recall reranks with MaxSim per token.
# Opt-in for a reason: on the same LoCoMo harness colbert-small scored below
# bge-large (better only on multi-hop questions; server RELEASE_NOTES).

# --- Records (docker-compose.records.yml) --------------------------------------
# One indexed vector plus up to 8 named extra representations per record.
# Limits of one record's extras (defaults 4096 vectors / 8 MiB; over = 413):
# DAKERA_RECORD_MAX_VECTORS=4096
# DAKERA_RECORD_MAX_BYTES=8388608

# --- RaBitQ (docker-compose.rabitq.yml) -----------------------------------------
# DAKERA_SEARCH_MODE=rabitq. Bits per dimension, 1-8 (default 1; 4 is the usual
# quality point). The codes live in memory next to the float vectors (no memory
# saving) and are re-encoded on the first search after a restart.
# DAKERA_RABITQ_BITS=1

# =============================================================================
# Watchdog (optional — monitors container health)
# =============================================================================

# Health check interval in seconds
# DAKERA_WATCHDOG_POLL_SECS=30

# Restart after N consecutive health failures
# DAKERA_WATCHDOG_RESTART_AFTER=5

# Memory alert threshold (percentage of container limit)
# DAKERA_WATCHDOG_MEM_ALERT_PCT=90

# =============================================================================
# Docker Images (optional — defaults to latest published images)
# =============================================================================

# The default is pinned to Dakera v0.12.3 and Dashboard 0.5.2 (v0.11: the release/0.11 branch).
# The :gpu / :cuda server images (CUDA 13 from v0.12.3) need NVIDIA driver R580 or newer on the host.
# DAKERA_IMAGE=ghcr.io/dakera-ai/dakera:0.12.3
# DASHBOARD_IMAGE=ghcr.io/dakera-ai/dakera-dashboard:0.5.2

# Dashboard 0.5.0 (profile "dashboard"; deploys like 0.4.0): operators sign in at /login with their own
# Dakera API key, held in the dashboard's server memory. The dashboard container has
# no API key: DAKERA_API_KEY and DAKERA_CLIENT_URL are no longer used. If your
# previous dashboard carried DAKERA_ROOT_API_KEY, rotate that key.
# Longest a sign-in lasts, in hours (default 12; idle sessions end after 2 h):
# DAKERA_SESSION_TTL_HOURS=12
# Dashboard 0.5.2: the reverse proxies in front of the dashboard (addresses / CIDRs,
# comma or space separated) whose X-Forwarded-For names the client, for the sign-in
# throttle. Empty: the connecting peer is the client. A proxy on the host reaches the
# container from the Docker bridge gateway (`docker network inspect dakera_dakera-net`).
# DAKERA_TRUSTED_PROXIES=172.18.0.1

# =============================================================================
# Observability (optional)
# =============================================================================

# RUST_LOG=info
# GRAFANA_USER=admin
# Grafana's admin password (--profile monitoring). No default: a NEW Grafana refuses
# to start without one (or with "admin"); one that already has its database keeps
# its password. openssl rand -hex 16
# GRAFANA_PASSWORD=
