# Caddyfile — production reverse proxy for 178.104.45.161
# Managed in dakera-deploy; deploy step: sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# DO NOT hand-edit /etc/caddy/Caddyfile directly — changes will be lost on box rebuild.

http://:8443 {
    @browser {
        header Accept *text/html*
    }
    basicauth @browser {
        admin $2a$14$TZYKgHkKdtbVomN5iio4x.v3t2Bm1rOuaTilvFrLglOk1AsmRfrsy
    }
    reverse_proxy localhost:3002 {
        header_down -WWW-Authenticate
    }
}

https://178.104.45.161:3004 {
    tls internal
    reverse_proxy localhost:3044
}

https://178.104.45.161:443 {
    tls internal
    reverse_proxy localhost:3000
}

https://178.104.45.161:3005 {
    tls internal
    # gzip saves ~73% on the Paperclip UI bundle (6.5MB → ~1.8MB cold load). Measured 2026-08-29.
    encode zstd gzip
    reverse_proxy localhost:3100
}

paperclip.178-104-45-161.sslip.io {
    encode zstd gzip
    reverse_proxy localhost:3100
}
